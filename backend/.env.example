# FlexSpace Backend — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
NODE_ENV=development
PORT=3001
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000
ANALYTICS_HASH_SALT=CHANGE_ME_TO_A_RANDOM_SECRET
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
AI_SEARCH_MODEL=gpt-5-mini

# --- Database (28_DATABASE_DDL.sql target) ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=flexspace
DB_PASSWORD=flexspace_dev_password
DB_DATABASE=flexspace
DB_SSL=false

# --- Auth (11_API_CONTRACTS.md §11.4) ---
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_DEV_ONLY_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DEV_ONLY_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP (passwordless auth — email channel implemented; SMS pending vendor per 17_NOTIFICATION_ARCHITECTURE.md §17.6) ---
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- OAuth (Google/Facebook Sign-In — additive to OTP, both optional) ---
# Google: only a Client ID is needed here (ID-token verification needs no
# secret). Create one at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> "Web application"), and add the frontend's origin
# under "Authorized JavaScript origins" (no redirect URI needed for this
# flow). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend exactly.
GOOGLE_CLIENT_ID=
# Facebook: create an app at https://developers.facebook.com/apps, add the
# "Facebook Login" product, and add the frontend's origin under Facebook
# Login -> Settings -> "Valid OAuth Redirect URIs" / "Allowed Domains for
# the JavaScript SDK". FACEBOOK_APP_ID must match NEXT_PUBLIC_FACEBOOK_APP_ID
# on the frontend; FACEBOOK_APP_SECRET stays server-only, never exposed to
# the browser.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Payments (13_PAYMENT_ARCHITECTURE.md) ---
# REQUIRES USER ACTION: no sandbox credentials were available at implementation
# time (see PHASE4_REPORT.md). The EpointPaymentProvider adapter is fully
# implemented against Epoint's documented API shape and is functionally
# testable via the FakePaymentProvider test double, but is NOT verified
# against Epoint's real sandbox until these are filled in and the adapter is
# smoke-tested against it.
EPOINT_MERCHANT_ID=
EPOINT_SECRET_KEY=
EPOINT_API_BASE_URL=https://api.epoint.az
EPOINT_WEBHOOK_SIGNATURE_ALGO=sha1-hmac

PAYRIFF_PUBLIC_KEY=
PAYRIFF_SECRET_KEY=
PAYRIFF_API_BASE_URL=https://api.payriff.com

# Which adapter is primary/active (13_PAYMENT_ARCHITECTURE.md §13.4)
PAYMENT_PRIMARY_PROVIDER=EPOINT

# --- Email (17_NOTIFICATION_ARCHITECTURE.md §17.6) ---
# Development default: a local/dev SMTP catcher (e.g. Mailhog/Mailpit) or a
# real provider's SMTP credentials. Production should use SES/Resend per
# 23_COST_MODEL.md — this is abstracted behind NotificationChannel so swapping
# is a config + adapter change, not a rewrite.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FlexSpace <no-reply@flexspace.az>"

# --- Object storage (22_INFRASTRUCTURE.md §22.7) ---
# REQUIRES USER ACTION: no object storage credentials configured yet.
# Photo upload endpoints are implemented against this interface but photo
# storage falls back to local disk in development only — see PHASE4_REPORT.md.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Provider verification documents (ID, business registration, address
# proof) — a SEPARATE directory from STORAGE_LOCAL_PATH, never statically
# served (admin-only, via GET admin/providers/:id/verification-documents/:key).
STORAGE_PRIVATE_LOCAL_PATH=./uploads-private
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Absolute origin the backend is reachable at, used only to turn a relative
# /uploads/<key> photo path into a full URL in API responses (the frontend
# runs on its own separate domain, so a relative path would resolve wrong
# there). On Railway this defaults to RAILWAY_PUBLIC_DOMAIN automatically —
# only set this to override that, or in any other hosting environment.
PUBLIC_BACKEND_URL=

# --- Booking engine (12_RESERVATION_ENGINE.md) ---
BOOKING_HOLD_MINUTES=15
# Customer-facing service fee shown as a separate line item (05_USER_FLOWS.md
# §5.2). No rate is fixed in any approved document — REQUIRES USER ACTION /
# BUSINESS DECISION. Defaults to 0 (no fee charged) until set.
BOOKING_SERVICE_FEE_PERCENTAGE=0

# --- Commission (13_PAYMENT_ARCHITECTURE.md §13.5) ---
PLATFORM_DEFAULT_COMMISSION_PERCENTAGE=12.00

# --- Payment redirects & refund authorization (13_PAYMENT_ARCHITECTURE.md §13.3, 18_SECURITY.md §18.2) ---
# PAYMENT_SUCCESS_URL_TEMPLATE / PAYMENT_ERROR_URL_TEMPLATE default to
# CORS_ORIGIN + a path; {bookingId} is replaced at request time.
PAYMENT_SUCCESS_URL_TEMPLATE=
PAYMENT_ERROR_URL_TEMPLATE=
# No AZN threshold is fixed in any approved document — REQUIRES USER ACTION
# / BUSINESS DECISION. Defaults to 0 (every refund escalates to admin
# approval) until a real Support/Ops auto-approve limit is set.
REFUND_AUTO_APPROVE_LIMIT_MINOR_UNITS=0

# --- Payouts (14_PAYOUT_LEDGER.md §14.5) ---
# No minimum batch amount is fixed in any approved document — defaults to 0
# (any positive eligible balance is batched into a Payout on the next run).
PAYOUT_MIN_AMOUNT_MINOR_UNITS=0

# --- Search relevance weights (16_SEARCH_ARCHITECTURE.md §16.3) ---
# Tunable post-launch from real conversion data, without a deployment.
# Availability is never weighted here — it's a hard exclude, not a score term.
SEARCH_WEIGHT_PRICE=0.25
SEARCH_WEIGHT_DISTANCE=0.25
SEARCH_WEIGHT_RATING=0.25
SEARCH_WEIGHT_AMENITY_MATCH=0.15
SEARCH_WEIGHT_CAPACITY_FIT=0.10
# §16.4 short-TTL read-through cache duration (cache layer not yet wired up).
SEARCH_CACHE_TTL_SECONDS=45

# --- Partner/Referral (31_PARTNER_REFERRAL_ARCHITECTURE.md) ---
PARTNER_PUBLIC_BASE_URL=[MARKETPLACE_DOMAIN]
PARTNER_IP_HASH_SALT=CHANGE_ME_IN_PRODUCTION
