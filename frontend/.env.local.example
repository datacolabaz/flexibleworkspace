# Spotva frontend — local environment template.
# Copy to .env.local (gitignored) and fill in real values. Never commit
# .env.local. Anything NOT prefixed NEXT_PUBLIC_ stays server-only (Route
# Handlers, middleware) — Next.js will refuse to inline it into client
# bundles, which is what keeps backend/OAuth secrets out of the browser
# per the approved go-ahead ("never expose backend secrets/OAuth secrets
# to the browser").

# --- Backend API (server-side only — read by Route Handlers acting as
# the BFF, never fetched directly from the browser) ---
BACKEND_API_URL=http://localhost:3001/api/v1

# --- BFF session cookies (server-side only) ---
# Signs/encrypts the httpOnly session cookie the BFF route handlers set
# after exchanging credentials with the backend (FRONTEND_IMPLEMENTATION_
# PLAN.md §4, item 1). Generate a real one with: openssl rand -base64 32
SESSION_COOKIE_SECRET=

# --- Public, browser-safe values only below this line ---
# The frontend's own base URL (used for canonical/hreflang tags, OG image
# absolute URLs — 19_SEO.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps JS API key, browser-restricted (HTTP referrer restrictions
# configured in Google Cloud Console, not by this app) — 15_MAPS_
# ARCHITECTURE.md. Safe to expose: it's restricted by referrer, not secret.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
